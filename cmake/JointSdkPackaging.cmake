if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    return()
endif()

option(JOINT_SDK_PORTABLE_LINUX "Package against the glibc 2.28 baseline" OFF)
if(JOINT_SDK_PORTABLE_LINUX)
    execute_process(COMMAND getconf GNU_LIBC_VERSION OUTPUT_VARIABLE _glibc
        OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _glibc_status)
    if(CMAKE_CROSSCOMPILING OR NOT _glibc_status EQUAL 0 OR NOT _glibc STREQUAL "glibc 2.28")
        message(FATAL_ERROR "Portable packages must be built natively in the glibc 2.28 CI image")
    endif()
    if(NOT BUILD_SHARED_LIBS)
        message(FATAL_ERROR "Portable packages require BUILD_SHARED_LIBS=ON")
    endif()
    set_target_properties(couple_joint_solver PROPERTIES
        VERSION 1.0.0 SOVERSION 1 INSTALL_RPATH "$ORIGIN"
        VISIBILITY_INLINES_HIDDEN ON)
    target_link_options(couple_joint_solver PRIVATE "LINKER:--exclude-libs,ALL")
endif()

install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_SOURCE_DIR}/debian/copyright"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/jointsdk")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_NAME "jointsdk")
set(CPACK_PACKAGE_VENDOR "Encos")
set(CPACK_PACKAGE_CONTACT "Encos Team <Sales002@encos.cn>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "C++17 joint control SDK and coupled joint solver")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGING_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}")
set(CPACK_SOURCE_GENERATOR "")
# A source build works without either distribution's packaging tools.
set(CPACK_GENERATOR "TGZ")
find_program(JOINT_SDK_DPKG_DEB dpkg-deb)
find_program(JOINT_SDK_RPMBUILD rpmbuild)
if(JOINT_SDK_DPKG_DEB)
    list(APPEND CPACK_GENERATOR "DEB")
endif()
if(JOINT_SDK_RPMBUILD)
    list(APPEND CPACK_GENERATOR "RPM")
endif()

if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    set(_deb_arch amd64)
    set(_rpm_arch x86_64)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    set(_deb_arch arm64)
    set(_rpm_arch aarch64)
else()
    set(_deb_arch "${CMAKE_SYSTEM_PROCESSOR}")
    set(_rpm_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif()
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "${_deb_arch}")
set(CPACK_RPM_PACKAGE_ARCHITECTURE "${_rpm_arch}")
set(CPACK_DEBIAN_PACKAGE_SECTION "libdevel")
set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
set(CPACK_DEBIAN_PACKAGE_DEPENDS "libencosdriver (>= 4.0.0), libeigen3-dev, libstdc++6, libc6")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_RPM_PACKAGE_LICENSE "MIT AND BSL-1.0")
set(CPACK_RPM_PACKAGE_REQUIRES "libencosdriver >= 4.0.0, eigen3-devel")
set(CPACK_RPM_PACKAGE_RELEASE "1")
set(CPACK_RPM_FILE_NAME "${CPACK_PACKAGE_NAME}_${PROJECT_VERSION}_linux_${_deb_arch}.rpm")
set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}_${PROJECT_VERSION}_linux_${_deb_arch}")
if(JOINT_SDK_PORTABLE_LINUX)
    set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}_${PROJECT_VERSION}_linux-glibc2.28_${_deb_arch}")
    set(CPACK_RPM_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.rpm")
    # Explicit baseline requirements are validated by audit-elf.py before packaging.
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS OFF)
    set(CPACK_DEBIAN_PACKAGE_DEPENDS "libencosdriver (>= 4.0.0), libeigen3-dev (>= 3.3.4), libc6 (>= 2.28), libstdc++6 (>= 8), libgcc-s1 | libgcc1")
    set(CPACK_RPM_PACKAGE_REQUIRES "libencosdriver >= 4.0.0, eigen3-devel >= 3.3.4, glibc >= 2.28, libstdc++ >= 8, libgcc")
    set(CPACK_RPM_PACKAGE_AUTOREQPROV OFF)
    set(CPACK_RPM_PACKAGE_PROVIDES "libcouple_joint_solver.so.1()(64bit)")
    set(CPACK_RPM_SPEC_MORE_DEFINE "%define __os_install_post %{nil}\n%define _build_id_links none")
endif()
set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA "${PROJECT_SOURCE_DIR}/scripts/portable/postinst;${PROJECT_SOURCE_DIR}/scripts/portable/postrm")
set(CPACK_DEBIAN_PACKAGE_CONTROL_STRICT_PERMISSION TRUE)
set(CPACK_RPM_POST_INSTALL_SCRIPT_FILE "${PROJECT_SOURCE_DIR}/scripts/portable/postinst")
set(CPACK_RPM_POST_UNINSTALL_SCRIPT_FILE "${PROJECT_SOURCE_DIR}/scripts/portable/postrm")
