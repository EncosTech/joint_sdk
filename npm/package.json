{
  "name": "@encos/joint-sdk",
  "version": "1.4.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://git.in.encos.cn/api/packages/packages/npm/"
  },
  "scripts": {
    "clean": "rm -rf dist *.tgz",
    "sync-version": "node ./scripts/sync-version.mjs",
    "generate:motor-model": "node ./scripts/generate-motor-model.mjs",
    "build:ts": "tsc -p tsconfig.build.json",
    "copy:wasm": "node ./scripts/copy-wasm-artifacts.mjs",
    "build": "pnpm run sync-version && pnpm run generate:motor-model && pnpm run clean && pnpm run build:ts && pnpm run copy:wasm",
    "test": "bash ../scripts/test-wasm.sh",
    "test:unit": "vitest run --config vitest.config.ts",
    "setup:browser-fixture": "rm -rf ../tests/wasm-browser/node_modules/@encos && mkdir -p ../node_modules/@encos && rm -rf ../node_modules/@encos/joint-sdk && mkdir -p ../node_modules/@encos/joint-sdk && cp -R dist package.json ../node_modules/@encos/joint-sdk/",
    "test:browser": "mkdir -p ../tests/wasm-browser/node_modules/@playwright && ln -sfn ../../../../npm/node_modules/@playwright/test ../tests/wasm-browser/node_modules/@playwright/test && playwright test --config playwright.config.ts ../tests/wasm-browser",
    "pack:check": "pnpm pack --pack-destination .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.0.0",
    "playwright": "^1.45.0",
    "postcss": "8.5.15",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
